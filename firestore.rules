rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin is enforced via existence of a document in the admins collection
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'hYgSo3Q4LNf317sChN8pUtMlvvE3' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false; // Must be created manually via Firebase Console
    }

    match /posts/{postId} {
      // READ: approved public posts visible to all; private to owner/admin
      allow read: if
        (resource.data.status == 'approved'
          && resource.data.visibility == 'public')
        || isAdmin()
        || (isSignedIn()
            && resource.data.authorId == request.auth.uid
            && resource.data.status != 'deleted');

      // CREATE: Must be signed in, and authorId must match auth.uid
      allow create: if isSignedIn() 
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.likes == 0
                    && request.resource.data.reportCount == 0
                    && request.resource.data.visibility in ['public', 'private'];

      // UPDATE: Admins can do anything. Owners can submit pending edits or direct edits if pending. Anyone can like/report with strict validation.
      allow update: if isAdmin()
                    || isValidLikeToggle()
                    || isValidReportAdd()
                    || isValidPendingEdit()
                    || isValidDirectEdit();

      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if true;
      // Allow user to write their own profile, but restrict sensitive fields
      allow write: if isAdmin() || (isOwner(uid) && isValidUserProfileUpdate());
    }

    match /meta/{docId} {
      allow read: if isAdmin();
      // Allow signed in users to increment counts
      allow write: if isAdmin() || (isSignedIn() && isValidMetaUpdate());
    }

    // ─── Validation functions ──────────────────────────────────────────────────

    function isValidLikeToggle() {
      let uid = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      let authed = isSignedIn();
      let postOk = before.status == 'approved' && before.status != 'deleted';
      let onlyLikeFields = after.keys().hasOnly(before.keys()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likes']);

      let addingLike =
        !before.likedBy.hasAny([uid])
        && after.likedBy.hasAll(before.likedBy)
        && after.likedBy.hasAll([uid])
        && after.likedBy.size() == before.likedBy.size() + 1
        && after.likes == before.likes + 1;

      let removingLike =
        before.likedBy.hasAny([uid])
        && before.likedBy.hasAll(after.likedBy)
        && !after.likedBy.hasAny([uid])
        && after.likedBy.size() == before.likedBy.size() - 1
        && after.likes == before.likes - 1;

      return authed && postOk && onlyLikeFields && (addingLike || removingLike);
    }

    function isValidReportAdd() {
      let uid = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      let authed = isSignedIn();
      let notOwn = before.authorId != uid;
      let notDuplicate = !before.reportedBy.hasAny([uid]);
      let onlyReportFields = request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBy', 'reportCount', 'lastReportReason']);

      let validAdd =
        after.reportedBy.hasAll(before.reportedBy)
        && after.reportedBy.hasAll([uid])
        && after.reportedBy.size() == before.reportedBy.size() + 1
        && after.reportCount == before.reportCount + 1;

      return authed && notOwn && notDuplicate && onlyReportFields && validAdd;
    }

    function isValidPendingEdit() {
      let uid = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      let isOwner = before.authorId == uid;
      let postOk = before.status == 'approved';
      let onlyEditFields = request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingEdit', 'visibility', 'updatedAt']);
      return isOwner && postOk && onlyEditFields;
    }

    function isValidDirectEdit() {
      let uid = request.auth.uid;
      let before = resource.data;
      let isOwner = before.authorId == uid;
      let isPending = before.status == 'pending';
      let forbidden = ['authorId', 'likes', 'likedBy', 'reportCount', 'reportedBy', 'status'];
      return isOwner && isPending && !request.resource.data.diff(resource.data).affectedKeys().hasAny(forbidden);
    }

    function isValidUserProfileUpdate() {
      let isCreating = resource == null;
      let diff = isCreating ? request.resource.data.keys() : request.resource.data.diff(resource.data).affectedKeys();
      // Block changing postCount from the client. Admins bypass this.
      return isCreating || !diff.hasAny(['postCount']);
    }

    function isValidMetaUpdate() {
      let isCreating = resource == null;
      let diff = isCreating ? request.resource.data.keys() : request.resource.data.diff(resource.data).affectedKeys();
      let onlyPendingCount = diff.hasOnly(['pendingCount']);
      let validCreation = isCreating && request.resource.data.pendingCount == 1;
      let validChange = !isCreating && request.resource.data.pendingCount == resource.data.pendingCount + 1;
      return onlyPendingCount && (validCreation || validChange);
    }
  }
}
